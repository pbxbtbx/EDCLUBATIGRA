# No third-party service or secret is required. Export these variables before starting.
# Python's standard library does not load .env files automatically.
ATIGRA_DB=data/atigra.sqlite3
ATIGRA_HOST=127.0.0.1
ATIGRA_PORT=8000
# 1 initializes demo accounts on a NEW database and shows demo shortcuts.
# Set 0 and run manage.py init-clean for a database without demo accounts.
ATIGRA_DEMO=1
# Use 1 behind an HTTPS reverse proxy. Local HTTP requires 0.
ATIGRA_SECURE_COOKIE=0
